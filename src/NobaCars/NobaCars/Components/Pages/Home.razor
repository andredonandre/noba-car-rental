@page "/"
@rendermode InteractiveServer
@using NobaCars.Infra.Entities
@using NobaCars.Infra
@using NobaCars.Core.Interfaces
@using NobaCars.Core.Models.Booking
@inject IInventoryService InventoryService
@inject IBookingService BookingService

<PageTitle>Home</PageTitle>
<header class="">
    <div class="container-xl">
        <div class="py-4 border-bottom">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-4 ">
                <div class="">
                    <h1 class="ls-tight h3 ">
                        Rental Bookings
                    </h1>
                </div>
            </div>
        </div>
    </div>   
</header>
<div>
    <div class="table-responsive">
        <table class="table table-wrap ">
            <thead class="">
                <tr>
                    <th colspan="2">Name</th>
                    <th>SSN</th>
                    <th>Car</th>
                    <th>From</th>
                    <th>To</th>
                    <th>Status</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>               
                    @foreach (var booking in bookings)                    
                    {
                   <tr>
                    <td colspan="2">
                            <a href="" class="fw-semibold text-heading text-primary-hover">@booking.Customer?.FirstName @booking.Customer?.LastName</a>
                    </td>
                    <td>
                            @booking.Customer?.SocialSecurityNumber
                    </td>
                    <td>
                            @booking.Car.Name
                    </td>
                    <td>
                           @booking.StartDate.ToShortDateString()
                     </td>
                     <td>
                          @booking.EndDate.ToShortDateString()
                    </td>
                    <td>
                            @switch (booking.Status)
                            {
                                case RentalStatus.Booked:
                                    <span class="badge text-warning-emphasis bg-warning-subtle border border-warning-subtle rounded-pill">
                                        @booking.Status
                                    </span>
                                    break;
                                case RentalStatus.Ongoing:
                                    <span class="badge text-success-emphasis bg-success-subtle border border-success-subtle rounded-pill">
                                        @booking.Status
                                    </span>
                                    break;
                                case RentalStatus.Complete:
                                    <span class="badge text-light-emphasis bg-light-subtle border border-dark-subtle rounded-pill">
                                        @booking.Status
                                    </span>
                                    break;
                            }                           
                    </td>                   
                    <td class="text-end">
                            @if (booking.Status == RentalStatus.Booked)
                            {                               
                                 <div class="dropdown">
                                    <button class="btn btn-sm btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Pick-up
                                    </button>
                                    <div class="dropdown-menu">
                                        <form @onsubmit="() => RegisterPickup(booking.Id, booking.StartDate)">
                                            <div class="dropdown-item d-flex align-items-center">
                                                <div class="text-lg">
                                                    <input class="form-control" @bind-value="@booking.StartDate" type="date" id="pickupTime" name="pickupTime" aria-label="...">
                                                </div>
                                            </div>          
                                            <div class="dropdown-item">
                                                <button class="btn btn-sm btn-success w-100">Register Pickup</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                            else if (booking.Status == RentalStatus.Ongoing)
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-warning dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Drop-off
                                    </button>
                                    <div class="dropdown-menu">
                                        <form @onsubmit="() => RegisterDropoff(booking.Id, booking.EndDate, booking.Car.MileAge)">
                                            <div class="dropdown-item d-flex align-items-center">
                                                <div class="text-lg">
                                                    <input class="form-control" @bind-value="@booking.EndDate" type="date" id="dropOffTime" name="dropOffTime" aria-label="...">
                                                </div>
                                            </div>
                                            <div class="dropdown-item d-flex align-items-center">
                                                <div class="text-lg">
                                                    <input class="form-control" @bind-value="@booking.Car.MileAge" type="number" id="endMileage" name="endMileage" aria-label="...">
                                                </div>
                                            </div>
                                            <div class="dropdown-item">
                                                <button class="btn btn-sm btn-warning w-100">Register Drop off</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            }
                            else if (booking.Status == RentalStatus.Complete)
                            {
                                <span>@booking?.Rental?.Price SEK</span>
                            }

                      </td>
                </tr>
                    }               
                <tr>
                    <td><InputText placeholder="First Name" class="form-control" @bind-Value="bookingModel!.Customer.FirstName" /></td>
                    <td><InputText placeholder="Last Name" class="form-control" @bind-Value="bookingModel!.Customer.LastName" /></td>
                    <td><InputNumber placeholder="Social Security" class="form-control" @bind-Value="bookingModel!.Customer.SocialSecurityNumber"/></td>                   
                    <td>
                        <InputSelect class="form-select" @bind-Value="selectedCar" @onchange="() => ChangeCar(selectedCar)">
                            @foreach (var car in cars)
                            {
                                <option value="@car.Id">@car.Name</option>
                            }
                        </InputSelect>
                    </td>
                    <td><InputDate placeholder="Pick-up Time" class="form-control" @bind-Value="bookingModel!.PickUp" /></td>
                    <td><InputDate placeholder="Drop-Off Time" class="form-control" @bind-Value="bookingModel!.DropOff" /></td>
                    <td></td>
                    <td><button @onclick="AddBooking" class="btn btn-primary">Add</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@code{

    private List<Car> cars = new();
    private List<Booking> bookings = new();
    private CreateBookingModel bookingModel = new();
    private int selectedCar = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(400);
        LoadData();
    }

    private void LoadData()
    {
        bookings = BookingService.GetBookings().ToList();
        cars = InventoryService.GetCars().ToList();
        bookingModel.Car = cars.First();
        selectedCar = bookingModel.Car.Id;

    }
    private async Task AddBooking()
    {
        await BookingService.CreateBooking(bookingModel);
        bookingModel = new();
        LoadData();
    } 

    private void ChangeCar(int carId)
    {
        if (carId == null) return;
        var newCar = cars.Where(c => c.Id == carId).First();
        bookingModel?.Car = newCar;
    }

    private async Task RegisterPickup(int bookingId, DateTime? PickUpTime)
    {
        await BookingService.RegisterPickup(bookingId, (DateTime)PickUpTime);
        LoadData();
    }

    private async Task RegisterDropoff(int bookingId,DateTime DropOffTime,int endMileage)
    {
        await BookingService.RegisterDropOff(bookingId, DropOffTime, endMileage);
        LoadData();
    }
}

